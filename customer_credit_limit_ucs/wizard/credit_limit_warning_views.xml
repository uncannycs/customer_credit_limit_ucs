<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_credit_limit_warning_wizard_form" model="ir.ui.view">
        <field name="name">credit.limit.warning.wizard.form</field>
        <field name="model">credit.limit.warning.wizard</field>
        <field name="arch" type="xml">
            <form string="Credit Limit Warning">
                <field name="currency_id" invisible="1"/>
                <field name="is_manager" invisible="1"/>
                
                <div class="alert alert-danger text-center" role="alert">
                    <h4 class="alert-heading"><strong>Credit Limit Exceeded!</strong></h4>
                    <p>The total exposure of the customer exceeds their credit limit.</p>
                </div>
                
                <group>
                    <group string="Credit Information">
                        <field name="partner_id" readonly="1" options="{'no_open': True}"/>
                        <field name="credit_limit" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="total_exposure" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" class="text-danger font-weight-bold"/>
                        <field name="exceeded_amount" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" class="text-danger font-weight-bold"/>
                    </group>
                    <group string="Exposure Breakdown">
                        <field name="total_receivables" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="pending_orders_amount" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="current_order_amount" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </group>
                </group>
                
                <notebook>
                    <page string="Unpaid Invoices" name="unpaid_invoices">
                        <field name="unpaid_invoice_ids" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="currency_id" column_invisible="True"/>
                                <field name="name"/>
                                <field name="invoice_date"/>
                                <field name="amount_total" sum="Total Amount"/>
                                <field name="amount_residual" sum="Total Residual"/>
                                <field name="payment_state" widget="badge" decoration-warning="payment_state == 'partial'" decoration-danger="payment_state == 'not_paid'"/>
                                <field name="state" invisible="1"/>
                            </list>
                        </field>
                    </page>
                    <page string="Pending Sale Orders" name="pending_orders">
                        <field name="uninvoiced_order_ids" readonly="1">
                            <list create="0" edit="0" delete="0">
                                <field name="currency_id" column_invisible="True"/>
                                <field name="name"/>
                                <field name="date_order"/>
                                <field name="amount_total" sum="Total Amount"/>
                                <field name="invoice_status" widget="badge" decoration-info="invoice_status == 'to invoice'"/>
                                <field name="state" invisible="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                
                <footer>
                    <button name="action_request_approval" string="Exceed Limit" type="object" class="btn-primary" data-hotkey="q"/>
                    <button name="action_confirm_order" string="Approve &amp; Confirm" type="object" class="btn-success" groups="sales_team.group_sale_manager" data-hotkey="w"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
